/*
 * Application-specific device tree overlay for ESP32-C6 SuperMini
 */

/ {
	chosen {
		zephyr,console = &usb_serial;
		zephyr,shell-uart = &usb_serial;
	};

	aliases {
		qdec0 = &pcnt;
	};

	fstab {
		compatible = "zephyr,fstab";
		ffs1: ffs1 {
			compatible = "zephyr,fstab,fatfs";
			automount;
			disk-access;
			mount-point = "/SD:";
		};
	};
};

&pinctrl {
	pcnt_default: pcnt_default {
		group1 {
			pinmux = <PCNT0_CH0SIG_GPIO6>,
				 <PCNT0_CH0CTRL_GPIO7>;
			bias-pull-up;
		};
	};

	uart0_default: uart0_default {
		group1 {
			pinmux = <UART0_TX_GPIO16>;
			output-high;
		};

		group2 {
			pinmux = <UART0_RX_GPIO17>;
			bias-pull-up;
		};
	};

	spim2_default: spim2_default {
		group1 {
			pinmux = <SPIM2_MISO_GPIO1>,
				 <SPIM2_SCLK_GPIO2>,
				 <SPIM2_CSEL_GPIO4>;
		};

		group2 {
			pinmux = <SPIM2_MOSI_GPIO3>;
			output-low;
		};
	};

	i2s_default: i2s_default {
		group1 {
			pinmux = <I2S_O_BCK_GPIO19>,
				 <I2S_O_WS_GPIO18>,
				 <I2S_O_SD_GPIO20>;
			output-enable;
		};
	};
};

&pcnt {
	pinctrl-0 = <&pcnt_default>;
	pinctrl-names = "default";
	status = "okay";
	#address-cells = <1>;
	#size-cells = <0>;
	unit0@0 {
		reg = <0>;
		#address-cells = <1>;
		#size-cells = <0>;
		filter = <100>;
		channelA@0 {
			reg = <0>;
			sig-pos-mode = <2>;
			sig-neg-mode = <1>;
			ctrl-h-mode = <0>;
			ctrl-l-mode = <1>;
		};
	};
};

&usb_serial {
	status = "okay";
};

&spi2 {
	dmas = <&dma 0>, <&dma 1>;
	dma-names = "tx", "rx";

	sdhc0: sdhc@0 {
		compatible = "zephyr,sdhc-spi-slot";
		reg = <0>;
		status = "okay";
		spi-max-frequency = <24000000>;
		mmc {
			compatible = "zephyr,sdmmc-disk";
			disk-name = "SD";
			status = "okay";
		};
	};
};
